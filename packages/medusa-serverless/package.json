{
  "name": "@rigby-software-house/medusa-serverless",
  "version": "0.1.0",
  "description": "Initialize Medusa modules for serverless and edge environments",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "medusa",
    "serverless",
    "edge",
    "modules"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.0.0",
    "@medusajs/modules-sdk": "^2.0.0",
    "@medusajs/utils": "^2.0.0"
  },
  "dependencies": {
    "@mikro-orm/postgresql": "6.4.16",
    "awilix": "^8.0.1"
  }
}